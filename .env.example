# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Server-side Anthropic API key to run the Anthropic Claude agent via /api/ai/*
# ANTHROPIC_API_KEY=""

# Optional: Free local Ollama or OpenAI-compatible server endpoint (no browser key UI)
# OLLAMA_BASE_URL="http://localhost:11434/v1/chat/completions"
# CUSTOM_AI_BASE_URL=""
# CUSTOM_AI_API_KEY=""
